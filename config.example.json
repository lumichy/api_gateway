    },
    {
      "id": "claude",
      "type": "claude",
      "models": ["sonnet"],
      "enabled": false,
      "billingVerified": false,
      "command": "claude",
      "priority": 20,
      "maxConcurrency": 1
    },
    {
      "id": "codex",
      "type": "codex",
