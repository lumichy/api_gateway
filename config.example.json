      "maxConcurrency": 1
    },
    {
      "id": "openrouter",
      "type": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "quotaSource": "openrouter",
      "models": ["openrouter/free"],
      "enabled": false,
      "billingVerified": false,
      "allowAuto": false,
      "priority": 100,
      "maxConcurrency": 1
    }
