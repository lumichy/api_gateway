{
  "name": "subscription-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "demo": "node src/main.ts --config config.demo.json",
    "test": "node --test tests/*.test.ts",
    "doctor": "node scripts/doctor.ts",
    "quota": "node --env-file=.env.local scripts/quota.ts",
    "typecheck": "tsc --noEmit",
    "format:src": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  }
}
